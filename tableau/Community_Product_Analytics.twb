            <column datatype='real' name='[answered_rate]' role='measure' type='quantitative' />
            <column datatype='real' name='[accepted_rate]' role='measure' type='quantitative' />
            <column-instance column='[asked_year]' derivation='None' name='[none:asked_year:ok]' pivot='key' type='ordinal' />
            <column-instance column='[answered_rate]' derivation='Sum' name='[sum:answered_rate:qk]' pivot='key' type='quantitative' />
            <column-instance column='[accepted_rate]' derivation='Sum' name='[sum:accepted_rate:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Line' />
            <encodings><text column='[federated.question_funnel_yearly].[sum:answered_rate:qk]' /></encodings>
          </pane>
        </panes>
        <rows>[federated.question_funnel_yearly].[sum:answered_rate:qk]</rows>
        <cols>[federated.question_funnel_yearly].[none:asked_year:ok]</cols>
      </table>
      <simple-id uuid='{D1D6FA3E-E9F7-474C-BBAA-F7F264483390}' />
    </worksheet>
    <worksheet name="Top Tags: Accept Rate">
      <layout-options><title><formatted-text><run bold='true'>Top Tags: Accept Rate</run><run fontsize='9' fontcolor='#6b7280'>&#10;15 highest-volume tags, mature questions only.</run></formatted-text></title></layout-options>
      <table>
        <view>
          <datasources><datasource caption='tag_health' name='federated.tag_health' /></datasources>
          <datasource-dependencies datasource='federated.tag_health'>
            <column datatype='string' name='[tag]' role='dimension' type='nominal' />
            <column datatype='real' name='[accept_rate]' role='measure' type='quantitative' />
            <column datatype='integer' name='[questions]' role='measure' type='quantitative' />
            <column-instance column='[tag]' derivation='None' name='[none:tag:nk]' pivot='key' type='nominal' />
            <column-instance column='[accept_rate]' derivation='Sum' name='[sum:accept_rate:qk]' pivot='key' type='quantitative' />
            <column-instance column='[questions]' derivation='Sum' name='[sum:questions:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.tag_health].[none:tag:nk]'><groupfilter function='level-members' level='[none:tag:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter>
          <computed-sort column='[federated.tag_health].[none:tag:nk]' direction='DESC' using='[federated.tag_health].[sum:accept_rate:qk]' />
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Bar' />
            <encodings><text column='[federated.tag_health].[sum:accept_rate:qk]' /><tooltip column='[federated.tag_health].[sum:questions:qk]' /></encodings>
          </pane>
        </panes>
        <rows>[federated.tag_health].[none:tag:nk]</rows>
        <cols>[federated.tag_health].[sum:accept_rate:qk]</cols>
      </table>
      <simple-id uuid='{BB366D9C-97A7-4856-A99A-D6E878F358EB}' />
    </worksheet>
    <worksheet name="A/A Test: Experiment Pipeline Check">
      <layout-options><title><formatted-text><run bold='true'>A/A Test: Experiment Pipeline Check</run><run fontsize='9' fontcolor='#6b7280'>&#10;24,587 real 2023 sign-ups, hash-split 50/50, no treatment. Text = control | treatment | p-value.</run></formatted-text></title></layout-options>
      <table>
        <view>
          <datasources><datasource caption='experiment_aa' name='federated.experiment_aa' /></datasources>
          <datasource-dependencies datasource='federated.experiment_aa'>
            <column datatype='string' name='[metric]' role='dimension' type='nominal' />
            <column datatype='string' name='[verdict]' role='dimension' type='nominal' />
            <column datatype='real' name='[control_mean]' role='measure' type='quantitative' />
            <column datatype='real' name='[treatment_mean]' role='measure' type='quantitative' />
            <column datatype='real' name='[p_value]' role='measure' type='quantitative' />
            <column-instance column='[metric]' derivation='None' name='[none:metric:nk]' pivot='key' type='nominal' />
            <column-instance column='[verdict]' derivation='None' name='[none:verdict:nk]' pivot='key' type='nominal' />
            <column-instance column='[control_mean]' derivation='Sum' name='[sum:control_mean:qk]' pivot='key' type='quantitative' />
            <column-instance column='[treatment_mean]' derivation='Sum' name='[sum:treatment_mean:qk]' pivot='key' type='quantitative' />
            <column-instance column='[p_value]' derivation='Sum' name='[sum:p_value:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Text' />
            <encodings><text column='[federated.experiment_aa].[sum:control_mean:qk]' /><text column='[federated.experiment_aa].[sum:treatment_mean:qk]' /><text column='[federated.experiment_aa].[sum:p_value:qk]' /></encodings>
          </pane>
        </panes>
        <rows>[federated.experiment_aa].[none:metric:nk] / [federated.experiment_aa].[none:verdict:nk]</rows>
        <cols></cols>
      </table>
      <simple-id uuid='{5D73EC8A-C534-4CBF-A53E-A4979A633473}' />
    </worksheet>
    <worksheet name="Dataset SLAs">
      <layout-options><title><formatted-text><run bold='true'>Dataset SLAs</run><run fontsize='9' fontcolor='#6b7280'>&#10;Checked on every pipeline run; any breach fails the run.</run></formatted-text></title></layout-options>
      <table>
        <view>
          <datasources><datasource caption='sla_status' name='federated.sla_status' /></datasources>
          <datasource-dependencies datasource='federated.sla_status'>
            <column datatype='string' name='[sla_type]' role='dimension' type='nominal' />
            <column datatype='string' name='[description]' role='dimension' type='nominal' />
            <column datatype='string' name='[target]' role='dimension' type='nominal' />
            <column datatype='string' name='[status]' role='dimension' type='nominal' />
            <column datatype='real' name='[observed]' role='measure' type='quantitative' />
            <column-instance column='[sla_type]' derivation='None' name='[none:sla_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[description]' derivation='None' name='[none:description:nk]' pivot='key' type='nominal' />
            <column-instance column='[target]' derivation='None' name='[none:target:nk]' pivot='key' type='nominal' />
            <column-instance column='[status]' derivation='None' name='[none:status:nk]' pivot='key' type='nominal' />
