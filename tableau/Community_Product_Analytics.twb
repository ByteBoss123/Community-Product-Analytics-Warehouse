  <worksheets>
    <worksheet name="Weekly Active Contributors">
      <layout-options><title><formatted-text><run bold='true'>Weekly Active Contributors</run><run fontsize='9' fontcolor='#6b7280'>&#10;Blue = new this week, orange = returning. Users with 1+ attributable action that week.</run></formatted-text></title></layout-options>
      <table>
        <view>
          <datasources><datasource caption='weekly_active_long' name='federated.weekly_active_long' /></datasources>
          <datasource-dependencies datasource='federated.weekly_active_long'>
            <column datatype='date' name='[week_start]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[contributors]' role='measure' type='quantitative' />
            <column datatype='string' name='[segment]' role='dimension' type='nominal' />
            <column-instance column='[week_start]' derivation='None' name='[none:week_start:qk]' pivot='key' type='quantitative' />
            <column-instance column='[contributors]' derivation='Sum' name='[sum:contributors:qk]' pivot='key' type='quantitative' />
            <column-instance column='[segment]' derivation='None' name='[none:segment:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Bar' />
            <encodings><color column='[federated.weekly_active_long].[none:segment:nk]' /></encodings>
          </pane>
        </panes>
        <rows>[federated.weekly_active_long].[sum:contributors:qk]</rows>
        <cols>[federated.weekly_active_long].[none:week_start:qk]</cols>
      </table>
      <simple-id uuid='{FE8546A1-2CB9-44B9-AAAF-7187F135D9E6}' />
    </worksheet>
    <worksheet name="Contributor Retention">
      <layout-options><title><formatted-text><run bold='true'>Contributor Retention</run><run fontsize='9' fontcolor='#6b7280'>&#10;Orange = launch-week cohort (87), blue = all later cohorts (377). Zero-return weeks count as 0.</run></formatted-text></title></layout-options>
      <table>
        <view>
          <datasources><datasource caption='retention_curve' name='federated.retention_curve' /></datasources>
          <datasource-dependencies datasource='federated.retention_curve'>
            <column datatype='integer' name='[week_offset]' role='dimension' type='ordinal' />
            <column datatype='real' name='[retention_rate]' role='measure' type='quantitative' />
            <column datatype='string' name='[cohort_group]' role='dimension' type='nominal' />
            <column-instance column='[week_offset]' derivation='None' name='[none:week_offset:ok]' pivot='key' type='ordinal' />
            <column-instance column='[retention_rate]' derivation='Sum' name='[sum:retention_rate:qk]' pivot='key' type='quantitative' />
            <column-instance column='[cohort_group]' derivation='None' name='[none:cohort_group:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Line' />
            <encodings><color column='[federated.retention_curve].[none:cohort_group:nk]' /><text column='[federated.retention_curve].[sum:retention_rate:qk]' /></encodings>
          </pane>
        </panes>
        <rows>[federated.retention_curve].[sum:retention_rate:qk]</rows>
        <cols>[federated.retention_curve].[none:week_offset:ok]</cols>
      </table>
      <simple-id uuid='{06C8AFD6-B3DC-4835-9D13-4DFF3BCE54D1}' />
    </worksheet>
    <worksheet name="Questions Asked per Week">
      <layout-options><title><formatted-text><run bold='true'>Questions Asked per Week</run><run fontsize='9' fontcolor='#6b7280'>&#10;Orange = asked under 14 days before snapshot end, excluded from funnel rates.</run></formatted-text></title></layout-options>
      <table>
        <view>
          <datasources><datasource caption='question_funnel' name='federated.question_funnel' /></datasources>
          <datasource-dependencies datasource='federated.question_funnel'>
            <column datatype='date' name='[asked_week]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[asked]' role='measure' type='quantitative' />
            <column datatype='string' name='[maturity]' role='dimension' type='nominal' />
            <column-instance column='[asked_week]' derivation='None' name='[none:asked_week:qk]' pivot='key' type='quantitative' />
            <column-instance column='[asked]' derivation='Sum' name='[sum:asked:qk]' pivot='key' type='quantitative' />
            <column-instance column='[maturity]' derivation='None' name='[none:maturity:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Bar' />
            <encodings><color column='[federated.question_funnel].[none:maturity:nk]' /></encodings>
          </pane>
        </panes>
        <rows>[federated.question_funnel].[sum:asked:qk]</rows>
        <cols>[federated.question_funnel].[none:asked_week:qk]</cols>
      </table>
      <simple-id uuid='{CFAA75FE-1A52-4157-929F-B64EF48706E4}' />
    </worksheet>
    <worksheet name="Answered Rate per Week">
      <layout-options><title><formatted-text><run bold='true'>Answered Rate per Week</run><run fontsize='9' fontcolor='#6b7280'>&#10;Share of questions with at least one answer. Orange = too recent to judge.</run></formatted-text></title></layout-options>
      <table>
        <view>
          <datasources><datasource caption='question_funnel' name='federated.question_funnel' /></datasources>
          <datasource-dependencies datasource='federated.question_funnel'>
            <column datatype='date' name='[asked_week]' role='dimension' type='ordinal' />
            <column datatype='real' name='[answered_rate]' role='measure' type='quantitative' />
            <column datatype='string' name='[maturity]' role='dimension' type='nominal' />
            <column-instance column='[asked_week]' derivation='None' name='[none:asked_week:qk]' pivot='key' type='quantitative' />
            <column-instance column='[answered_rate]' derivation='Sum' name='[sum:answered_rate:qk]' pivot='key' type='quantitative' />
            <column-instance column='[maturity]' derivation='None' name='[none:maturity:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Circle' />
            <encodings><color column='[federated.question_funnel].[none:maturity:nk]' /></encodings>
          </pane>
        </panes>
        <rows>[federated.question_funnel].[sum:answered_rate:qk]</rows>
        <cols>[federated.question_funnel].[none:asked_week:qk]</cols>
      </table>
      <simple-id uuid='{F5803100-817F-4678-8F0F-2B9D29FC11E8}' />
    </worksheet>
    <worksheet name="Tag Accept Rate">
      <layout-options><title><formatted-text><run bold='true'>Tag Accept Rate</run><run fontsize='9' fontcolor='#6b7280'>&#10;Tags with 20+ mature questions.</run></formatted-text></title></layout-options>
      <table>
        <view>
          <datasources><datasource caption='tag_health' name='federated.tag_health' /></datasources>
          <datasource-dependencies datasource='federated.tag_health'>
            <column datatype='string' name='[tag]' role='dimension' type='nominal' />
            <column datatype='real' name='[accept_rate]' role='measure' type='quantitative' />
            <column datatype='integer' name='[questions]' role='measure' type='quantitative' />
            <column-instance column='[tag]' derivation='None' name='[none:tag:nk]' pivot='key' type='nominal' />
            <column-instance column='[accept_rate]' derivation='Sum' name='[sum:accept_rate:qk]' pivot='key' type='quantitative' />
            <column-instance column='[questions]' derivation='Sum' name='[sum:questions:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.tag_health].[none:tag:nk]'><groupfilter function='level-members' level='[none:tag:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter>
          <computed-sort column='[federated.tag_health].[none:tag:nk]' direction='DESC' using='[federated.tag_health].[sum:accept_rate:qk]' />
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Bar' />
            <encodings><text column='[federated.tag_health].[sum:accept_rate:qk]' /><tooltip column='[federated.tag_health].[sum:questions:qk]' /></encodings>
          </pane>
        </panes>
        <rows>[federated.tag_health].[none:tag:nk]</rows>
        <cols>[federated.tag_health].[sum:accept_rate:qk]</cols>
      </table>
      <simple-id uuid='{3E4BC5E2-5D9A-4AEE-B9D1-68CF72AB5DFD}' />
    </worksheet>
    <worksheet name="Dataset SLAs">
      <layout-options><title><formatted-text><run bold='true'>Dataset SLAs</run><run fontsize='9' fontcolor='#6b7280'>&#10;Checked on every pipeline run; any breach fails the Airflow run.</run></formatted-text></title></layout-options>
      <table>
        <view>
          <datasources><datasource caption='sla_status' name='federated.sla_status' /></datasources>
          <datasource-dependencies datasource='federated.sla_status'>
            <column datatype='string' name='[sla_type]' role='dimension' type='nominal' />
            <column datatype='string' name='[description]' role='dimension' type='nominal' />
            <column datatype='string' name='[target]' role='dimension' type='nominal' />
            <column datatype='string' name='[status]' role='dimension' type='nominal' />
            <column datatype='real' name='[observed]' role='measure' type='quantitative' />
            <column-instance column='[sla_type]' derivation='None' name='[none:sla_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[description]' derivation='None' name='[none:description:nk]' pivot='key' type='nominal' />
            <column-instance column='[target]' derivation='None' name='[none:target:nk]' pivot='key' type='nominal' />
            <column-instance column='[status]' derivation='None' name='[none:status:nk]' pivot='key' type='nominal' />
            <column-instance column='[observed]' derivation='Sum' name='[sum:observed:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Text' />
            <encodings><text column='[federated.sla_status].[sum:observed:qk]' /><color column='[federated.sla_status].[none:status:nk]' /></encodings>
          </pane>
        </panes>
        <rows>[federated.sla_status].[none:sla_type:nk] / [federated.sla_status].[none:description:nk] / [federated.sla_status].[none:target:nk] / [federated.sla_status].[none:status:nk]</rows>
        <cols></cols>
      </table>
      <simple-id uuid='{7205A57E-4D97-4A0F-8FDF-24C5A906264F}' />
    </worksheet>
  </worksheets>
