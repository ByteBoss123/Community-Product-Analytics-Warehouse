  <worksheets>
    <worksheet name="Monthly Active Contributors">
      <layout-options><title><formatted-text><run bold='true'>Monthly Active Contributors</run><run fontsize='9' fontcolor='#6b7280'>&#10;Blue = first contribution that month, orange = returning. Peak 2017, declining since.</run></formatted-text></title></layout-options>
      <table>
        <view>
          <datasources><datasource caption='monthly_active_long' name='federated.monthly_active_long' /></datasources>
          <datasource-dependencies datasource='federated.monthly_active_long'>
            <column datatype='date' name='[month_start]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[contributors]' role='measure' type='quantitative' />
            <column datatype='string' name='[segment]' role='dimension' type='nominal' />
            <column-instance column='[month_start]' derivation='None' name='[none:month_start:qk]' pivot='key' type='quantitative' />
            <column-instance column='[contributors]' derivation='Sum' name='[sum:contributors:qk]' pivot='key' type='quantitative' />
            <column-instance column='[segment]' derivation='None' name='[none:segment:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Area' />
            <encodings><color column='[federated.monthly_active_long].[none:segment:nk]' /></encodings>
          </pane>
        </panes>
        <rows>[federated.monthly_active_long].[sum:contributors:qk]</rows>
        <cols>[federated.monthly_active_long].[none:month_start:qk]</cols>
      </table>
      <simple-id uuid='{9D6BC8B3-C0F1-4482-AD7F-40E1C412686E}' />
    </worksheet>
    <worksheet name="Retention by Cohort Era">
      <layout-options><title><formatted-text><run bold='true'>Retention by Cohort Era</run><run fontsize='9' fontcolor='#6b7280'>&#10;Share of each first-contribution cohort active again N months later. Blue 2010-14, orange 2015-19, red 2020-23.</run></formatted-text></title></layout-options>
      <table>
        <view>
          <datasources><datasource caption='retention_by_era' name='federated.retention_by_era' /></datasources>
          <datasource-dependencies datasource='federated.retention_by_era'>
            <column datatype='integer' name='[month_offset]' role='dimension' type='ordinal' />
            <column datatype='real' name='[retention_rate]' role='measure' type='quantitative' />
            <column datatype='string' name='[cohort_era]' role='dimension' type='nominal' />
            <column-instance column='[month_offset]' derivation='None' name='[none:month_offset:ok]' pivot='key' type='ordinal' />
            <column-instance column='[retention_rate]' derivation='Sum' name='[sum:retention_rate:qk]' pivot='key' type='quantitative' />
            <column-instance column='[cohort_era]' derivation='None' name='[none:cohort_era:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Line' />
            <encodings><color column='[federated.retention_by_era].[none:cohort_era:nk]' /></encodings>
          </pane>
        </panes>
        <rows>[federated.retention_by_era].[sum:retention_rate:qk]</rows>
        <cols>[federated.retention_by_era].[none:month_offset:ok]</cols>
      </table>
      <simple-id uuid='{4E7F8369-30CE-46A6-9FCD-AA9B1ABC66F5}' />
    </worksheet>
    <worksheet name="Questions Asked per Year">
      <layout-options><title><formatted-text><run bold='true'>Questions Asked per Year</run><run fontsize='9' fontcolor='#6b7280'>&#10;Orange = 2024, partial year (dump ends 2024-03-31).</run></formatted-text></title></layout-options>
      <table>
        <view>
          <datasources><datasource caption='question_funnel_yearly' name='federated.question_funnel_yearly' /></datasources>
          <datasource-dependencies datasource='federated.question_funnel_yearly'>
            <column datatype='integer' name='[asked_year]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[asked]' role='measure' type='quantitative' />
            <column datatype='string' name='[coverage]' role='dimension' type='nominal' />
            <column-instance column='[asked_year]' derivation='None' name='[none:asked_year:ok]' pivot='key' type='ordinal' />
            <column-instance column='[asked]' derivation='Sum' name='[sum:asked:qk]' pivot='key' type='quantitative' />
            <column-instance column='[coverage]' derivation='None' name='[none:coverage:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Bar' />
            <encodings><color column='[federated.question_funnel_yearly].[none:coverage:nk]' /></encodings>
          </pane>
        </panes>
        <rows>[federated.question_funnel_yearly].[sum:asked:qk]</rows>
        <cols>[federated.question_funnel_yearly].[none:asked_year:ok]</cols>
      </table>
      <simple-id uuid='{4F5962A8-E73C-47F8-83B0-36F124FDC796}' />
    </worksheet>
    <worksheet name="Answered Rate per Year">
      <layout-options><title><formatted-text><run bold='true'>Answered Rate per Year</run><run fontsize='9' fontcolor='#6b7280'>&#10;Share of questions with at least one answer, by year asked.</run></formatted-text></title></layout-options>
      <table>
        <view>
          <datasources><datasource caption='question_funnel_yearly' name='federated.question_funnel_yearly' /></datasources>
          <datasource-dependencies datasource='federated.question_funnel_yearly'>
            <column datatype='integer' name='[asked_year]' role='dimension' type='ordinal' />
            <column datatype='real' name='[answered_rate]' role='measure' type='quantitative' />
            <column datatype='real' name='[accepted_rate]' role='measure' type='quantitative' />
            <column-instance column='[asked_year]' derivation='None' name='[none:asked_year:ok]' pivot='key' type='ordinal' />
            <column-instance column='[answered_rate]' derivation='Sum' name='[sum:answered_rate:qk]' pivot='key' type='quantitative' />
            <column-instance column='[accepted_rate]' derivation='Sum' name='[sum:accepted_rate:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Line' />
            <encodings><text column='[federated.question_funnel_yearly].[sum:answered_rate:qk]' /></encodings>
          </pane>
        </panes>
        <rows>[federated.question_funnel_yearly].[sum:answered_rate:qk]</rows>
        <cols>[federated.question_funnel_yearly].[none:asked_year:ok]</cols>
      </table>
      <simple-id uuid='{19508E12-525D-41D9-B519-517045BE6B60}' />
    </worksheet>
    <worksheet name="Top Tags: Accept Rate">
      <layout-options><title><formatted-text><run bold='true'>Top Tags: Accept Rate</run><run fontsize='9' fontcolor='#6b7280'>&#10;15 highest-volume tags, mature questions only.</run></formatted-text></title></layout-options>
      <table>
        <view>
          <datasources><datasource caption='tag_health' name='federated.tag_health' /></datasources>
          <datasource-dependencies datasource='federated.tag_health'>
            <column datatype='string' name='[tag]' role='dimension' type='nominal' />
            <column datatype='real' name='[accept_rate]' role='measure' type='quantitative' />
            <column datatype='integer' name='[questions]' role='measure' type='quantitative' />
            <column-instance column='[tag]' derivation='None' name='[none:tag:nk]' pivot='key' type='nominal' />
            <column-instance column='[accept_rate]' derivation='Sum' name='[sum:accept_rate:qk]' pivot='key' type='quantitative' />
            <column-instance column='[questions]' derivation='Sum' name='[sum:questions:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.tag_health].[none:tag:nk]'><groupfilter function='level-members' level='[none:tag:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter>
          <computed-sort column='[federated.tag_health].[none:tag:nk]' direction='DESC' using='[federated.tag_health].[sum:accept_rate:qk]' />
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Bar' />
            <encodings><text column='[federated.tag_health].[sum:accept_rate:qk]' /><tooltip column='[federated.tag_health].[sum:questions:qk]' /></encodings>
          </pane>
        </panes>
        <rows>[federated.tag_health].[none:tag:nk]</rows>
        <cols>[federated.tag_health].[sum:accept_rate:qk]</cols>
      </table>
      <simple-id uuid='{32BF69A6-B307-4408-985E-429BB4ED266B}' />
    </worksheet>
    <worksheet name="A/A Experiment Check">
      <layout-options><title><formatted-text><run bold='true'>A/A Experiment Check</run><run fontsize='9' fontcolor='#6b7280'>&#10;24,587 real 2023 sign-ups, hash-split 50/50, no treatment. No metric differs.</run></formatted-text></title></layout-options>
